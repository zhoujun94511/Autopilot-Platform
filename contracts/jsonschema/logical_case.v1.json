{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/contracts/logical_case.v1.json",
  "title": "LogicalTestCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_case_id",
    "project_id",
    "title",
    "logical_steps",
    "expected_results",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "logical_case_id": { "type": "string", "minLength": 1 },
    "case_key": { "type": "string" },
    "project_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "logical_steps": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expected_results": {
      "type": "array",
      "items": { "type": "string" }
    },
    "priority": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_type": { "type": "string" },
    "module": { "type": "string" },
    "source_requirement_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_status": {
      "type": "string",
      "enum": ["AI_DRAFT", "HUMAN_REVIEWED", "APPROVED", "REJECTED"]
    },
    "automatability": {
      "type": "string",
      "enum": ["AUTOMATABLE", "PARTIAL", "MANUAL_ONLY", "NEEDS_DESIGN", "UNKNOWN"]
    },
    "automation_status": {
      "type": "string",
      "enum": [
        "LOGICAL_ONLY",
        "INTENT_READY",
        "BINDING_PARTIAL",
        "DRAFT_AUTOMATION",
        "MAPPING_REQUIRED",
        "DEBUGGING",
        "EXECUTABLE",
        "PUBLISHED",
        "DEPRECATED"
      ]
    },
    "generation_metadata": { "type": "object" }
  }
}
