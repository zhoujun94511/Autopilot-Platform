# AutoPilot Platform 环境变量样例
# 复制为仓库根 `.env` 后按需修改。启动时会自动加载（已有环境变量不被覆盖）。
#
# ┌─ 配置优先级（详见 docs/CONFIGURATION.md）────────────────────────────┐
# │ 1. 运维配置中心 mc_runtime_config.json（Webhook、AI、策略）— 最高      │
# │ 2. 本文件 / 进程环境变量（MC_HOST/PORT、密钥、DB）                      │
# │ 3. 代码默认（如 http://127.0.0.1:8000）                                │
# └──────────────────────────────────────────────────────────────────────┘
#
# ┌─ 生产 Platform 公网地址（与 IDE 共用，只配一次）──────────────────────┐
# │ 复制 deploy/platform.env.example →                                    │
# │   C:\ProgramData\AutoPilot\platform.env                               │
# │   AUTOPILOT_PLATFORM_URL=https://autopilot.company.com              │
# │ Platform 与 IDE 启动时都会加载；此处无需再写 MC_PLATFORM_URL。         │
# └──────────────────────────────────────────────────────────────────────┘
#
# Windows PowerShell 手工加载（可选）:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -notmatch '=') { return }
#     $k,$v = $_.Split('=',2); [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process')
#   }
#
# bash:
#   set -a; source .env; set +a

# ---------- 监听 / 联调（bootstrap；不进运维 JSON）----------
MC_HOST=127.0.0.1
MC_PORT=8000
# MC_PLATFORM_URL=http://127.0.0.1:8000
# MC_SERVER=http://127.0.0.1:8000
# MC_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
# start_dev.py 会自动设置；此时 :8000 根路径重定向到 Vite，不要在生产设置。
# MC_FRONTEND_DEV_URL=http://127.0.0.1:5173

# ---------- HTTPS / TLS（生产；开发联调保持 HTTP）----------
# 详见 docs/setup/https.md。配置 MC_SSL_CERTFILE + MC_SSL_KEYFILE 后
# ``python -m autopilot_platform.platform`` 自动以 HTTPS 监听。
# 或使用反代：MC_BEHIND_HTTPS_PROXY=1 + MC_PLATFORM_URL=https://...
# MC_SSL_CERTFILE=
# MC_SSL_KEYFILE=
# MC_BEHIND_HTTPS_PROXY=0
# MC_FORWARDED_ALLOW_IPS=127.0.0.1
# HTTPS 本机联调：python start_dev_https.py start --auto-cert（默认 :8443）

# ---------- 环境（AUD-2026-06）----------
# 下方默认口令/密钥仅允许 loopback 开发。MC_ENV=production 或非 loopback 绑定
# （0.0.0.0 / LAN）时启动会失败，见 validate_production_security / validate_bind_security。
# 生产模板：deploy/production.env.example
# MC_ENV=production
# MC_REQUIRE_ADMIN_API_TOKEN=1

# ---------- 本机托管 Runner（Web 启停；浏览器不能在用户 PC 上直接起进程）----------
# Platform 与 Runner 同机、且仅绑定 loopback 时，admin 可在「执行节点」页启停托管子进程。
# 默认关闭；须显式 =1。MC_HOST=0.0.0.0 / --lan / 非本机 IP 时即使 =1 也禁止（远程禁止 Web→spawn）。
# MC_ALLOW_MANAGED_RUNNER=1
# MC_MANAGED_RUNNER_ID=managed-local
# MC_MANAGED_RUNNER_SERVER=http://127.0.0.1:8000
# Runner 连续 Job 复用本进程 Appium（跳过 suite teardown；默认关）：
# AUTOPILOT_RUNNER_KEEP_APPIUM=1

# ---------- 认证（开发默认值；生产见 deploy/production.env.example）----------
# MC_API_TOKEN：Runner / 执行通道全局 X-API-Token（与 runner --token 一致）
# 默认仅为执行通道（role=runner），不可升为平台 admin
# 警告：dev-mc-token / admin / 默认 JWT 仅限 127.0.0.1；勿用于生产或 --lan
MC_API_TOKEN=dev-mc-token
# MC_ADMIN_API_TOKEN：运维 / 平台 admin 专用 Token（与 MC_API_TOKEN 必须不同）
# 生产 / 非 loopback 绑定（0.0.0.0、局域网 IP）必须配置
# MC_ADMIN_API_TOKEN=
# 迁移逃生口：未配 ADMIN 时允许全局 MC_API_TOKEN 升 admin（默认关；勿用于生产）
# MC_ALLOW_LEGACY_TOKEN_ADMIN=1
MC_JWT_SECRET=dev-mc-jwt-secret-change-me-32b!!
# 运维 JSON 密钥落盘加密主密钥（推荐）；未设则回退「非默认」MC_JWT_SECRET。
# 禁止用开发默认 JWT 加密新密钥；缺安全材料时写入 AP_AI_API_KEY 等会失败。
# MC_CONFIG_SECRET=replace-with-long-random-string
MC_ACCESS_TOKEN_MINUTES=60
# Job 日志 SSE 短时票（分钟，默认 2，最大 15）；仅绑定单一 job，经 ?access_token= 给 EventSource
# MC_STREAM_TOKEN_MINUTES=2
MC_REFRESH_TOKEN_DAYS=14
# AUD-2026-02-C：Refresh HttpOnly Cookie。默认按请求是否 HTTPS 决定 Secure；
# 生产 HTTPS 可显式 =1；纯 HTTP 本机联调可 =0
# MC_COOKIE_SECURE=1

MC_ADMIN_USER=admin
MC_ADMIN_PASSWORD=admin

# ---------- 存储（默认均在仓库根 data/ 下）----------
# MC_DATA_DIR=./data
# MC_DATABASE_URL=sqlite:///./data/autopilot_platform.db
# MC_ARTIFACTS_DIR=
# MC_APP_BUILDS_DIR=
# MC_REPORTS_DIR=
# MC_JOB_LOGS_DIR=
# AP_DESIGN_UPLOADS_DIR=

# ---------- Platform 应用日志（stderr + 轮转文件）----------
# 默认落盘：仓库根 logs/platform_YYYYMMDD.log（与 data/ 分离）
# start_dev.py 会设置 MC_PLATFORM_LOGS_DIR=logs/dev/
# MC_PLATFORM_LOGS_DIR=
# MC_LOG_LEVEL=INFO
# MC_LOG_FORMAT=text
# MC_JOB_LOG_RETENTION_DAYS=90
# MC_AUDIT_LOG_RETENTION_DAYS=180
MC_STORAGE=local
# MC_S3_BUCKET=
# MC_S3_PREFIX=mc-artifacts/

# ---------- 调度 / 指标 ----------
# 后台 tick：计划触发 / 僵死回收 / 报告清理 / fleet 告警。
# 部署模型：同一数据库只需一个 schedule leader（多实例靠 ops_locks 租约选举）。
# 跟随节点可设 MC_SCHEDULE_ENABLED=0。SQLite 默认不适合多写 HA，请用 PostgreSQL。
MC_SCHEDULE_ENABLED=1
# MC_SCHEDULE_TICK_SEC=15
MC_METRICS_ENABLED=1
MC_JOB_STALE_SEC=1800
MC_REQUIRE_JOB_DEVICES=0
MC_REQUIRE_ARTIFACT_MANIFEST=0

# ---------- Job 终态 Webhook ----------
# MC_WEBHOOK_URL=http://127.0.0.1:9000/hooks/job
# MC_WEBHOOK_SECRET=

# ---------- 设计域 Intent：APPROVED 推送（IDE serve-webhook）----------
# 默认空=不推送。IDE 侧:
#   python -m autopilot.intent serve-webhook --project <工程>
# MC_DESIGN_WEBHOOK_URL=http://127.0.0.1:8765/hooks/intent
# 若未设 DESIGN URL 且下面=1，则兜底复用 MC_WEBHOOK_URL（慎用）
MC_DESIGN_WEBHOOK_USE_JOB_URL=0
# 签名与 Job 共用（可空=不校验）
# MC_WEBHOOK_SECRET=change-me
# 本机联调允许向 127.0.0.1 推送（默认关，防 SSRF）
# MC_WEBHOOK_ALLOW_LOOPBACK=1

# ---------- 运维告警 ----------
# MC_ALERT_WEBHOOK_URL=
# MC_ALERT_CHANNEL=json
# MC_ALERT_SECRET=
MC_ALERT_ON_FAILED=1
MC_ALERT_ON_STALE=1
# Runner 在线→离线边沿告警（需配置 MC_ALERT_WEBHOOK_URL；冷却默认 3600s）
MC_ALERT_ON_RUNNER_OFFLINE=1
# MC_ALERT_RUNNER_OFFLINE_COOLDOWN_SEC=3600
# Runner 仍在线但在线设备数 >0→0 时告警
MC_ALERT_ON_DEVICE_EMPTY=1

# ========== 设计域 AI（只配「一套」厂商，不要多段都解开）==========
# AUD-2026-05（密钥卫生）：
#   - 本机 `.env` 明文 Key 仅限开发；生产优先运维配置中心写入 AP_AI_API_KEY（落盘 enc:v1:）
#   - 务必设置 MC_CONFIG_SECRET；曾写入明文 JSON 的密钥会在 load 时自动升密
#   - 若 Key 曾进过可共享磁盘/备份，请在厂商侧轮换；IDE 侧优先系统密钥环，少放仓库旁 `.env`
# 规则：
#   1) 选一个厂商 -> 解开该方案 3~5 行 -> 其余方案保持注释
#   2) AP_AI_API_KEY / AP_AI_BASE_URL / AP_AI_MODEL 若填写则覆盖分厂商变量
#   3) 未配 Key（且非 ollama）时：设计生成走启发式，不调 LLM（degraded）
#      设 AP_AI_REJECT_DEGRADED=1 可拒绝启发式假通（默认关）
#   4) AP_AI_REASONING_EFFORT=none|minimal|low|medium|high|max（默认 none）
#   5) AP_AI_TEMPERATURE 默认 0.2；gpt-5 / Gemini3 / DeepSeek thinking 时请求体省略
#   6) AP_AI_VERBOSITY=none|low|medium|high（仅 OpenAI gpt-5；none=不传）
#   7) gpt-5 系自动使用 max_completion_tokens
#   详见 docs/architecture/AI_PROVIDER_PROFILE.md
#
# 可选公共项（与厂商无关，按需解开）：
# AP_AI_TIMEOUT_SEC=180
# AP_AI_MAX_TOKENS=4096
# 链路 3 默认跟随 AP_AI_MAX_TOKENS；只有要压成本时才下调（长用例调太低会被截断）
# AP_AI_CODEGEN_MAX_TOKENS=4096
# AP_AI_CODEGEN_MAX_ATTEMPTS=2
# AP_AI_TEMPERATURE=0.2
# AP_AI_REASONING_EFFORT=none
# AP_AI_VERBOSITY=low
# AP_AI_CHAT_MAX_ATTEMPTS=3
# AP_AI_REJECT_DEGRADED=0
# AP_AI_DAILY_TOKEN_BUDGET=0
# AP_AI_PROJECT_DAILY_TOKEN_BUDGET=0
# AP_AI_ORG_DAILY_TOKEN_BUDGET=0
# AP_AI_ENFORCE_TOKEN_BUDGET=0
# AP_RAG_EMBEDDER=auto

# --- 方案 A：OpenAI（推荐 5.4 / 5.6；4o 已偏旧）---
# AP_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AP_AI_TEMPERATURE=0.2
# AP_AI_REASONING_EFFORT=none
# AP_AI_VERBOSITY=low
# 备选：gpt-5.4 / gpt-5.6-terra / gpt-5-mini

# --- 方案 B：DeepSeek V4（最新；官方无像素多模态，设计域文本可用）---
# AP_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AP_AI_TEMPERATURE=0.2
# AP_AI_REASONING_EFFORT=none
# AP_AI_DEEPSEEK_THINKING=0
# AP_AI_DEEPSEEK_REASONING_EFFORT=high
# 重推理：DEEPSEEK_MODEL=deepseek-v4-pro 且 AP_AI_REASONING_EFFORT=high

# --- 方案 C：Gemini（OpenAI 兼容网关；推荐 3.5）---
# AP_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AP_AI_TEMPERATURE=0.2
# AP_AI_REASONING_EFFORT=none
# 备选：gemini-3.1-flash-lite；2.5 临近退役

# --- 方案 D：通义 / DashScope（文本 qwen-plus；视觉请用 qwen-vl-*）---
# AP_AI_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AP_AI_TEMPERATURE=0.2
# AP_AI_REASONING_EFFORT=none
# 国际区：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 需在控制台开通/购买对应模型，否则 AccessDenied.Unpurchased

# --- 方案 E：Ollama 本地（一般可不配 Key）---
# AP_AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- 可选：统一覆盖（不想记 OPENAI_/DEEPSEEK_ 前缀时）---
# AP_AI_PROVIDER=deepseek
# AP_AI_API_KEY=sk-...
# AP_AI_MODEL=deepseek-v4-flash
# AP_AI_BASE_URL=https://api.deepseek.com
# AP_AI_TEMPERATURE=0.2
# AP_AI_REASONING_EFFORT=none
# AP_AI_VERBOSITY=none

# ---------- 制品 / 报告保留 ----------
MC_ARTIFACT_RETENTION_DAYS=30
MC_APP_BUILD_RETENTION_DAYS=90
# Job 报告目录（HTML/result/evidence）；0=不按天自动限；purge: POST /api/v1/reports/purge
MC_JOB_REPORT_RETENTION_DAYS=90
MC_APP_BUILD_MAX_MB=512
# MC_APP_BUILD_MAX_COUNT=0
# MC_APP_BUILD_MAX_TOTAL_MB=0
# MC_ARTIFACT_MAX_MB=512

# ---------- SSO（默认关）----------
MC_OIDC_ENABLED=0
MC_SAML_ENABLED=0
# MC_OIDC_ISSUER=
# MC_OIDC_CLIENT_ID=
# MC_OIDC_CLIENT_SECRET=
# MC_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
# MC_OIDC_FRONTEND_REDIRECT=http://127.0.0.1:5173/

# ---------- 远控 TURN（跨 NAT）----------
MC_TURN_ENABLED=0
MC_TURN_REALM=autopilot.example.com
MC_TURN_URLS=stun:stun.l.google.com:19302
# 启用时使用独立的 32 字节以上密钥，须与 coturn static-auth-secret 一致
# MC_TURN_SECRET=
MC_TURN_CREDENTIAL_TTL_SEC=3600
MC_TURN_USERNAME_PREFIX=autopilot
