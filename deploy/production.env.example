# AutoPilot Platform — 生产 / 非 loopback 部署凭据模板（AUD-2026-06）
#
# 用法：
#   1. 复制本文件为仓库根 `.env`（或注入编排环境变量）
#   2. 将所有 CHANGE_ME_* 替换为强随机值（Runner Token ≠ Admin Token）
#   3. 设置 MC_ENV=production（启动时 validate_production_security 强制校验）
#   4. 非 127.0.0.1 绑定时同样强制强凭据（validate_bind_security）
#
# 切勿把真实密钥提交进 Git。开发本机联调请继续用仓库根 `.env.example`（仅 loopback）。
#
# HTTPS 详见 docs/setup/https.md

MC_ENV=production
MC_HOST=127.0.0.1
MC_PORT=8000
# 若对外暴露，务必放反向代理后，并改强下列密钥；直接 MC_HOST=0.0.0.0 时同样要求强凭据。
# MC_HOST=0.0.0.0

# 对外根 URL（须与 IDE platform.url 一致）
# MC_PLATFORM_URL=https://autopilot.company.com

# Runner / 执行通道（X-API-Token / runner --token）
MC_API_TOKEN=CHANGE_ME_runner_token_long_random

# 运维 / 平台 admin 专用（必须与 MC_API_TOKEN 不同）
MC_ADMIN_API_TOKEN=CHANGE_ME_admin_token_long_random

# JWT 签名密钥（足够长、不可预测）
MC_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes!!

# 引导管理员（首次建库）；生产禁止 admin/admin
MC_ADMIN_USER=platform-admin
MC_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# 运维 JSON 密钥落盘加密（推荐独立于 JWT）
MC_CONFIG_SECRET=CHANGE_ME_config_secret_long_random

MC_ACCESS_TOKEN_MINUTES=60
MC_REFRESH_TOKEN_DAYS=14

# 生产默认关闭 Web 托管 Runner（远程 UI 不应 spawn 本机进程）
# MC_ALLOW_MANAGED_RUNNER=0

# 生产跨域源（HTTPS 示例）
# MC_CORS_ORIGINS=https://autopilot.company.com

# ---------- HTTPS / TLS（二选一，详见 docs/setup/https.md）----------
# 模式 A — 反向代理终结 TLS（推荐）
# MC_BEHIND_HTTPS_PROXY=1
# MC_FORWARDED_ALLOW_IPS=127.0.0.1
#
# 模式 B — uvicorn 直连 TLS（证书 + 私钥均存在时自动启用）
# MC_SSL_CERTFILE=/etc/ssl/certs/autopilot.crt
# MC_SSL_KEYFILE=/etc/ssl/private/autopilot.key
# MC_SSL_CA_CERTS=/etc/ssl/certs/ca-chain.pem
#
# Refresh Cookie（HTTPS 建议显式开启 Secure）
# MC_COOKIE_SECURE=1

# Android WebRTC 跨 NAT：与 deploy/docker/coturn/.env 的共享密钥一致
MC_TURN_ENABLED=1
MC_TURN_REALM=autopilot.example.com
MC_TURN_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
MC_TURN_SECRET=CHANGE_ME_turn_secret_at_least_32_bytes
MC_TURN_CREDENTIAL_TTL_SEC=3600
