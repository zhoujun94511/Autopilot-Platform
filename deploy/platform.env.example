# 生产 Platform 公网基址（与 IDE 共用，只配一次）
# 复制到：
#   C:\ProgramData\AutoPilot\platform.env
#   /etc/autopilot/platform.env
#
# Platform 与 IDE 启动时都会加载；仓库 `.env` 无需再写 MC_PLATFORM_URL。
#
# IDE 客户端侧等价配置（任选其一，URL 须与本文件一致）：
#   - 与 AutoPilot.exe 同目录 platform.url（由 platform.url.example 复制改名）
#   - C:\ProgramData\AutoPilot\platform.url
#   - 环境变量 AUTOPILOT_PLATFORM_URL
# 企业内网私有 CA 的客户端信任：见 AutoPilot/docs/CONFIGURATION.md §1（组策略 AUTOPILOT_SSL_CA_FILE）
# 详见 docs/CONFIGURATION.md §7、docs/setup/https.md、docs/setup/managementconsole.md §10

AUTOPILOT_PLATFORM_URL=https://autopilot.company.com
